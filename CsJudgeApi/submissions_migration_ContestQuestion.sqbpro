SELECT CASE QuestionId
           WHEN 1 THEN 1
		   WHEN 2 THEN 1
		   ELSE
				QuestionId / 1000
       END AS ContestId,
	   QuestionId,
	   (QuestionId % 1000) AS Nro
from Questions
where QuestionId &lt; 202602100
order by QuestionId;

select *
from Questions
where QuestionId &gt;= 202602100;

insert into ContestQuestions (ContestId, QuestionId, [Order])
VALUES	(15, 202602100, 1);
insert into ContestQuestions (ContestId, QuestionId, [Order])
VALUES	(16, 202602101, 1);
insert into ContestQuestions (ContestId, QuestionId, [Order])
VALUES (17, 202602102, 1);
insert into ContestQuestions (ContestId, QuestionId, [Order])
VALUES (17, 202602103, 2);
insert into ContestQuestions (ContestId, QuestionId, [Order])
VALUES (18, 202602104, 1);
insert into ContestQuestions (ContestId, QuestionId, [Order])
VALUES (18, 202602105, 2);
insert into ContestQuestions (ContestId, QuestionId, [Order])
VALUES (18, 202602106, 3);
		

select *
from Contests
where SemesterId = 1;

select *
from ContestQuestions;</sql><current_tab id="0"/></tab_sql></sqlb_project>
