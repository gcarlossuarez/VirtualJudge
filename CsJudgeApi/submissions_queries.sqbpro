		Metadata-&gt;&gt; '$.studentName' AS nombre2,
		ActivityLogs.*
FROM ActivityLogs
WHERE Timestamp &gt;= '2026-09-25'
  -- 1. Elimina filas donde la columna sea NULL o esté vacía en SQL
  AND MetaData IS NOT NULL 
  AND TRIM(MetaData) != ''
  -- 2. Asegura que el JSON contenga la clave y que no sea un texto vacío ni un &quot;null&quot; de JSON
  AND Metadata -&gt;&gt; '$.studentName' IS NOT NULL
  AND TRIM(Metadata -&gt;&gt; '$.studentName') != ''
  ORDER BY Timestamp DESC;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
